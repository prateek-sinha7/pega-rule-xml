# =============================================================================
# Pega XML Downloader - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# CLI arguments (--url, --output-dir, --headless, --max-retries, --stages)
# take precedence over these environment variables.
# =============================================================================

# --- Required ---

# Base URL of the Pega Platform instance (e.g., https://pega.example.com/prweb)
PEGA_URL=https://pega.example.com/prweb

# Pega login credentials (required - script will exit if missing)
PEGA_USERNAME=your_username
PEGA_PASSWORD=your_password

# --- Optional (defaults shown) ---

# Directory where XML files, logs, and screenshots are saved
# ~/Downloads works on both Mac and Windows — resolves to the user's Downloads folder
OUTPUT_DIR=~/Downloads

# Run Chrome in headless mode (true/false)
HEADLESS=true

# Maximum retry attempts per rule extraction before marking as failed
MAX_RETRIES=3

# Comma-separated list of Case Type stages to process (in order)
# STAGE_LIST=Initialization,Primary,Alternatives  ← removed, no longer used

# Number of concurrent browser sessions for parallel downloads (1 = sequential)
PARALLEL_WORKERS=1

# Python logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Comma-separated list of Case Type names to download
# Single:   CASE_TYPE_NAMES=Tax Compliance Training
# Multiple: CASE_TYPE_NAMES=Tax Compliance Training,Tax Cost Allocation,My Other Case Type
CASE_TYPE_NAMES=Tax Compliance Training
